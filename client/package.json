{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tailwind:init": "tailwindcss init -p",
    "tailwind:build": "tailwindcss -i ./src/index.css -o ./dist/output.css --watch",
    "build:tailwind": "tailwindcss -i ./src/index.css -o ./dist/output.css --minify",
    "postcss:info": "postcss --config ./postcss.config.cjs --info",
    "api:types": "openapi-typescript http://localhost:8000/openapi.json -o src/shared/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/explora": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.1.1",
    "@tanstack/react-query": "^5.68.0",
    "axios": "^1.8.4",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "lucide-react": "^0.482.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.60.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.3.0",
    "tailwindcss": "^3.4.17",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "description": "This template provides a minimal setup to get React working in Vite with HMR and some ESLint rules.",
